# Copiar este fichero a /opt/ladderbot/secrets/ladderbot.env y rellenar los valores.
# Después:  chmod 700 /opt/ladderbot/secrets  &&  chmod 600 /opt/ladderbot/secrets/ladderbot.env
# Nunca subir este fichero a git ni pegarlo en un chat.

# --- Obligatorios -----------------------------------------------------------------
# RPC principal y respaldo de Polygon. Estos dos son públicos, gratuitos y no
# necesitan clave. El bot cambia al respaldo si el principal falla y conserva
# el último proveedor sano.
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_FALLBACK=https://polygon.drpc.org

# Clave privada de la wallet del bot (la que firma). Empieza por 0x y tiene 66 caracteres.
# Si la pegas mal (con espacios, comillas o sin 0x) el bot se niega a arrancar.
POLYGON_PRIVATE_KEY=0xTU_CLAVE_PRIVADA

# Dirección pública de esa misma wallet. El bot comprueba que se corresponde con la clave.
POLYGON_ADDRESS=0xTU_DIRECCION

# --- Opcionales (si no los pones, no avisa por Telegram) ---------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Manifiesto OTA oficial. Permite actualizar escribiendo solo /update.
# También se puede usar: /update URL_HTTPS SHA256
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/juanlusoft/ladderbot/main/latest.json
