[Unit]
Description=Apply a verified LadderBot OTA request
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ladderbot
ExecStart=/opt/ladderbot/.venv/bin/python /opt/ladderbot/updater.py apply-request
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
